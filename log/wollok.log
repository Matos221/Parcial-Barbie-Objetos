tions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"sourceMap":{"end":{"column":32,"line":32,"offset":581},"start":{"column":19,"line":32,"offset":568}}}},{"id":"29701716-4d59-414e-9b60-379ed70026d6","members":[{"body":{"id":"997f6a7f-aa3d-4570-a763-6de3651defaa","metadata":[],"problems":[],"scope":{"containerScope":{"containerScope":{"containerScope":{"containerScope":{"containerScope":{"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[{"containerScope":{"containerScope":{"containerScope":{"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]}]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"sentences":[],"sourceMap":{"end":{"column":21,"line":70,"offset":2451},"start":{"column":19,"line":70,"offset":2449}}},"compiled":false,"id":"7f86494a-5c35-40ec-9f25-2b7a3fc89e0b","isOverride":false,"metadata":[],"name":"brillo","parameters":[],"problems":[],"scope":{"containerScope":{"containerScope":{"containerScope":{"containerScope":{"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[{"containerScope":{"containerScope":{"containerScope":{"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]},"contributions":{},"includedScopes":[]}]},"contributions":{},"includedScopes":[]},"sourceMap":{"end":{"column":21,"line":70,"offset":2451},"start":{"column":3,"line":70,"offset":2433}}}],"metadata":[{"args":{"position":"start","text":"/********************************************************************************/"},"name":"comment"},{"args":{"position":"start","text":"/*\n  2) V o F\n    a. Verdadero\n      La solucion actual, plantea que la Barbie no tenga una profesion, no existe atributo que la relacione con una profesion.\n      Sumando que para las Barbies sin profesion, el metodo  brillo() debe dar 0.\n\n    b) Falso\n      La solucion actual, plantea a las profesiones y a las Barbies como algo completamente distintos.\n      En caso de buscar una conexion, no deberia ser via \"Herencia\". Sino que las profesiones sean un objeto que se instancia en toda Barbie.\n      Para agregar, de querer una barbie sin profesion creemos una profesion especial que de brillo() = 0.\n\n    c) Falso\n      En esta solucion no existe ninguna clase abstracta. Porque para que exista una clase abstracta esta debe tener metodos abstractos.\n      Lo cual no tenemos en esta situacion. \n      Aclaración: \n      Los métodos abstractos se definen como un método común, pero sin cuerpo. \n      Luego, sus subclases pueden aportar su implementación particular.\n    \n    d) Falso\n      No hay forma de que una Barbie cambie de profesion. Para hacerlo las profesiones deberian ser un atributo variable\n      en las Barbies. Pero, actualmente son clases completamente distintas.\n\nSe requiere conocer el brillo de cada invitado. La barbie presidenta tiene brillo 100 de base y se le suman 5\npor cada año que fue presidenta, la barbie sirena tiene un brillo diferente y la barbie astronauta es 10 por cada\nmisión espacial que haya cumplido. Una Barbie puede no tener profesión (en ese caso su brillo es 0), y podría\ncambiar de profesión. Alan es único, no hay otro como él, y su brillo es siempre 1. A la fiesta se pueden sumar\ninvitados.\nSe tiene la siguiente solución en Wollok:\n\n*/"},"name":"comment"},{"args":{"position":"start","text":"// 3) "},"name":"comment"},{"args":{"position":"end","text":"// Creo clase Barbie"},"name":"comment"}],"name":"Invitado","problems":[],"scope":{"containerScope":{"containerScope":{"containe